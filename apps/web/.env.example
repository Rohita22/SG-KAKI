# No secrets belong here — this file ships to the browser. See apps/server/.env.example
# for the Groq API key instead.
#
# Only needed if the frontend and backend are deployed to different origins
# (in local dev, Vite's /api proxy makes this unnecessary). Leave unset for relative
# /api/... requests, handled by the dev proxy or same-origin deployment.
# VITE_API_BASE_URL=https://your-backend.example.com

# Dev convenience: treat every AI Practice scenario as unlocked, so a scene can
# be opened for testing without completing its mission first. Leave unset in
# anything user-facing — it bypasses the mission progression.
# VITE_UNLOCK_ALL_SCENARIOS=true
