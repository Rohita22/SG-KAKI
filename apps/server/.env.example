# Copy to .env and fill in. This file (and .env) never gets sent to the browser.
PORT=8080
ALLOWED_ORIGINS=http://localhost:5183
GROQ_API_KEY=
# Optional: override the model (Groq rate-limits per-model, so switching here
# can unblock you if one model's daily quota runs out). Default: llama-3.1-8b-instant
GROQ_MODEL=
# Optional: override the model used for calls needing reliable JSON output
# (currently just AI-generated reply suggestions). Default: llama-3.3-70b-versatile
GROQ_STRUCTURED_MODEL=
