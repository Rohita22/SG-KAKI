{
  "name": "sg-mode-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w web && npm run build -w server",
    "test": "npm run test -w web",
    "test:e2e": "npm run test:e2e -w web",
    "lint": "npm run lint -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
